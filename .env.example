NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=*

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/echogpt?schema=public"


JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM key for stored AI provider API keys — 64 hex chars (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes every stored provider key undecryptable (re-enter them).
PROVIDER_KEY_ENCRYPTION_SECRET=
