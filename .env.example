# -----------------------------------------------------------------------------
# EchoGPT Backend — environment template
# Copy to .env and fill in. Every variable is validated at startup
# (src/config/env.validation.ts); the app refuses to boot and names the
# offending variable if one is missing or malformed.
# -----------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
# development | production | test
NODE_ENV=development
PORT=3000
# Every route is served under /<API_PREFIX> (Swagger UI at /<API_PREFIX>/docs).
API_PREFIX=api
# Allowed CORS origin. Use your extension's origin in production,
# e.g. chrome-extension://<extension-id>
CORS_ORIGIN=*

# --- Database (required) -----------------------------------------------------
# Any PostgreSQL 14+ instance. Local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/echogpt?schema=public"
# Hosted (Neon/Supabase) — use sslmode=verify-full to avoid pg's sslmode warning:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# --- JWT (required) ----------------------------------------------------------
# Two different random secrets, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Lifetimes in `ms` format (15m, 1h, 7d, ...).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Provider key encryption (required) --------------------------------------
# AES-256-GCM key for stored AI provider API keys — exactly 64 hex chars (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes every stored provider key undecryptable (re-enter them).
PROVIDER_KEY_ENCRYPTION_SECRET=
