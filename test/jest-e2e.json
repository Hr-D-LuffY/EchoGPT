{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.jest.json" }]
  },
  "transformIgnorePatterns": ["/node_modules/(?!@nestjs/(passport|jwt)/)"],
  "maxWorkers": 1,
  "testTimeout": 30000
}
